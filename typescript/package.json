{
  "name": "kotecharts",
  "version": "0.1.0",
  "description": "Free Bitcoin on-chain analytics API & MCP server: MVRV, NUPL, SOPR, exchange flows, whales",
  "keywords": ["bitcoin", "on-chain", "onchain-analytics", "mvrv", "nupl", "sopr", "crypto", "api", "sdk", "mcp"],
  "homepage": "https://kotecharts.com",
  "repository": { "type": "git", "url": "git+https://github.com/kote-charts/kote-charts.git", "directory": "typescript" },
  "bugs": { "url": "https://github.com/kote-charts/kote-charts/issues" },
  "license": "MIT",
  "author": "Kote Charts",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript ${KOTE_OPENAPI_URL:-https://kotecharts.com/api/v1/openapi.json} -o src/openapi.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
